# libFuzzer / AFL dictionary for config_fuzzer.cpp
# usage: ./config_fuzzer -dict=config_fuzzer.dict corpus_dir

# macro references
"$("
")"
"$$("
"$$(["
"])"
"$(DOLLAR)"
"$(1)"
"$(0)"
"$(0?)"
"$(0#)"
"$(1:default)"
":"

# special macro functions
"$ENV("
"$RANDOM_CHOICE("
"$RANDOM_INTEGER("
"$CHOICE("
"$SUBSTR("
"$INT("
"$REAL("
"$STRING("
"$EVAL("
"$BASENAME("
"$DIRNAME("
"$F("
"$Fq("
"$Fa("
"$Fqa("
"$Fn("
"$Fx("
"$Fd("
"$Fdd("
"$Fp("
"$Ff("
"$Fb("
"$Fw("
"$Fu("
"$Fpnx("

# quoting and separators
"\""
"'"
"\"\""
"''"
","
"/"
"\\"
"."
"%"

# assignment forms
"="
"+="
"@="
"@end"
"\x0a"
" \\\x0a"
"#"
"MASTER."
"TOOL."
"LOCAL."

# statements
"if "
"elif "
"else"
"endif"
"if defined "
"if version >= "
"true"
"false"
"use "
"use ROLE:Personal"
"use FEATURE:"
"use POLICY:"
"use SECURITY:"
"include : "
"include ifexist : "
"error : "
"warning : "
"#opt:oldcomment"
"#opt:newcomment"
"#opt:strict"
