"""
condor_updates_stats: summarize the collector's update statistics.

Reads long-form ClassAds (as printed by "condor_status -l") on stdin and,
for each ad carrying an UpdatesHistory attribute, displays the update
totals, the loss rate, and the history of received and missed updates.

Uses only the Python standard library.
"""

import re
import subprocess
import sys
import time

PROGRAM = "condor_updates_stats"
REVISION = "1.5"

USAGE = f"{PROGRAM} [options]"
OPTIONS = {
	"[--long|-l]": "Enable long output <off>",
	"[--summary|-s]": "Summary-only mode <off>",
	"[--history=[min][-max]]": "Set history range from min to max",
	"[--[no]time]": "Enable / disable time output (if available) <on>",
	"[--interval=seconds]": "Force ad update interval to seconds <no default>",
	"[--version]": "Displays version information <off>",
	"[--help|-h]": "Dump help",
}

config = {
	"hist_min": 0,
	"hist_max": 99999,
	"long": False,
	"summary_only": False,
	"update_interval": 0,
	"dump_time": True,
}

QUOTED_RE = re.compile(r'(\w*)\s*=\s*"(.*)"$')
UNQUOTED_RE = re.compile(r'(\w*)\s*=\s*(.*)$')
TYPED_RE = re.compile(r'Updates.*_(.*)')


def usage(unknown):
	if unknown:
		print(f"{PROGRAM}: unknown argument: '{unknown}'")
	print(f"usage: {USAGE}")
	print("use '-h' for more help")
	sys.exit(1)


def show_help():
	print(f"usage: {USAGE}")
	for opt in sorted(OPTIONS, key=str.lower):
		print(f"  {opt:>32s} : {OPTIONS[opt]:<40s}")
	sys.exit(0)


def show_version():
	try:
		result = subprocess.run(["condor_version"], stdout=subprocess.PIPE,
								universal_newlines=True, check=False)
		sys.stdout.write(result.stdout)
	except OSError:
		print(f"{PROGRAM} version: {REVISION}")
	sys.exit(0)


def parse_args(argv):
	for arg in argv:
		m = re.match(r'--history=(\d*)(-(\d+))?$', arg)
		if m:
			if m.group(1):
				config["hist_min"] = int(m.group(1))
			if m.group(3):
				config["hist_max"] = int(m.group(3))
			continue
		m = re.match(r'--interval=(\d+)', arg)
		if m:
			config["update_interval"] = int(m.group(1))
			config["dump_time"] = True
		elif arg in ("--summary", "-s"):
			config["summary_only"] = True
		elif arg == "--time":
			config["dump_time"] = True
		elif arg == "--notime":
			config["dump_time"] = False
		elif arg in ("--long", "-l"):
			config["long"] = True
		elif arg == "--version":
			show_version()
		elif arg in ("--help", "-h"):
			show_help()
		else:
			usage(arg)


def to_number(value, default=0):
	"""Convert an attribute value to a number the way Perl would:
	leading numeric part, or 0."""
	if value is None:
		return default
	m = re.match(r'\s*([-+]?(\d+\.?\d*|\.\d+)([eE][-+]?\d+)?)', str(value))
	if not m:
		return default
	num = float(m.group(1))
	return int(num) if num.is_integer() else num


def parse_hex(hex_str):
	"""Expand the hex history string into a list of 1 (Ok) / 0 (Missed).
	A set bit means the update was missed."""
	if hex_str[:2].lower() == "0x":
		hex_str = hex_str[2:]
	history = []
	for ch in hex_str:
		try:
			value = int(ch, 16)
		except ValueError:
			value = 0
		for mask in (0x8, 0x4, 0x2, 0x1):
			history.append(0 if (mask & value) else 1)
	return history


def dump_history(name_str, ad, update_type):
	"""Print the stats for one update type (None means the main counters).
	Returns True if the header was printed."""
	suffix = "" if update_type is None else "_" + update_type
	updates = {}
	if "UpdatesTotal" + suffix in ad:
		updates["total"] = ad["UpdatesTotal" + suffix]
		updates["seq"] = ad.get("UpdatesSequenced" + suffix, "")
		updates["lost"] = ad.get("UpdatesLost" + suffix, "")
	if "UpdatesHistory" + suffix in ad:
		updates["hist"] = ad["UpdatesHistory" + suffix]

	update_interval = config["update_interval"]
	if re.match(r'\d', ad.get("UpdateInterval", "")):
		update_interval = to_number(ad["UpdateInterval"])

	if name_str:
		print(name_str)
	print(" Type: " + (update_type if update_type is not None else "Main"))

	if "total" in updates:
		lost_percent = "0.00"
		seq = to_number(updates["seq"])
		if seq:
			lost_percent = f"{100.0 * to_number(updates['lost']) / seq:.2f}"
		print(f"   Stats: Total={updates['total']}, Seq={updates['seq']}, "
			  f"Lost={updates['lost']} ({lost_percent}%)")

	if config["summary_only"]:
		return True

	if "hist" in updates:
		history = parse_hex(updates["hist"])
		last_sample = len(history) - 1
		last_status = -1
		repeats = 0

		when = to_number(ad["LastHeardFrom"]) if "LastHeardFrom" in ad else time.time()

		for sample, status in enumerate(history):
			if config["hist_min"] <= sample <= config["hist_max"]:
				if not config["long"] and status == last_status and sample < last_sample:
					if not repeats:
						print("  ...")
					repeats += 1
				else:
					repeats = 0
					time_str = ""
					if update_interval and config["dump_time"]:
						time_str = " @ " + time.ctime(when)
					print(f"  {sample:4d}{time_str}: {'Ok' if status else 'Missed'}")
				last_status = status
			when -= update_interval
		print()

	return True


def dump_histories(ad, types):
	name = ad.get("Name", ad.get("Machine", "*Unknown*"))
	my_type = ad.get("MyType", "*Unknown*")
	name_str = f"*** Name/Machine = '{name}' MyType = '{my_type}' ***"

	if dump_history(name_str, ad, None):
		name_str = ""
	for update_type in types:
		dump_history(name_str, ad, update_type)


def main():
	parse_args(sys.argv[1:])

	ad = {}
	types = {}	# dict as an insertion-ordered set
	history_count = 0

	def flush():
		nonlocal ad, types, history_count
		if history_count:
			dump_histories(ad, types)
		ad = {}
		types = {}
		history_count = 0

	for line in sys.stdin:
		line = line.rstrip("\n")
		m = QUOTED_RE.search(line) or UNQUOTED_RE.search(line)
		if not m:
			flush()
			continue
		attr, value = m.group(1), m.group(2)
		ad[attr] = value
		if attr.startswith("UpdatesHistory"):
			history_count += 1
		else:
			tm = TYPED_RE.match(attr)
			if tm:
				types[tm.group(1)] = True

	# The last ad may not be followed by a blank line
	flush()


if __name__ == "__main__":
	try:
		main()
	except BrokenPipeError:
		sys.exit(0)
	except KeyboardInterrupt:
		sys.exit(1)
