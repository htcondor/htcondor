###########################################################################
#
#  This is condor_run, a simple front-end to condor_submit for submitting
#  vanilla jobs to Condor.
#
#  usage: condor_run "shell-cmd"
#
#  examples:
#
#    condor_run "zcat data.gz | awk -f myscript.awk > results.txt"
#    condor_run "cc -o myprog myprog.c"
#    condor_run "make"
#
#  Originally written in Perl by Jim Basney <jbasney@cs.wisc.edu> 4/3/2000
#
###########################################################################

usage() {
	echo "usage: $0 [-getenv] [-u <universe>] [-a command]* \"shell-cmd\""
	echo "	where shell-cmd is any Unix shell statement."
	echo "	-u lets you set the universe to which the job is submitted."
	echo "	   The default is vanilla."
	echo "	-a lets you add additional submit commands"
	echo "	   e.g. -a request_memory=1024"
	echo "	Environment variables CONDOR_ARCH, CONDOR_OPSYS, and"
	echo "	CONDOR_REQUIREMENTS may specify remote machine's Arch,"
	echo "	OpSys, and any additional requirements."
	exit 1
}

command=()
appends=()
universe=vanilla
getenv_flag=0

[[ $# -eq 0 ]] && usage

# Options may appear anywhere on the command line; anything that is not
# an option is part of the command to run.
while [[ $# -gt 0 ]]; do
	arg=$1
	shift
	case $arg in
		-h*)
			usage
			;;
		-u*)
			universe=${arg#-u}
			if [[ -z $universe ]]; then
				universe=$1
				shift
			fi
			;;
		-a*)
			appends+=("$1")
			shift
			;;
		-getenv*)
			getenv_flag=1
			;;
		*)
			command+=("$arg")
			;;
	esac
done

[[ ${#command[@]} -eq 0 ]] && usage

pid=$$
cmd_file=.condor_run.$pid
submit_file=.condor_submit.$pid
log_file=.condor_log.$pid
out_file=.condor_out.$pid
err_file=.condor_error.$pid
cluster=

# Let the user run something in the current directory without "./"
export PATH="$PATH:."

cleanfiles() {
	rm -f "$cmd_file" "$submit_file" "$log_file" "$out_file" "$err_file"
}

abort() {
	if [[ -n $cluster ]]; then
		condor_rm "$cluster" >/dev/null 2>&1
	fi
	cleanfiles
	printf '%s\n' "$1" >&2
	exit 1
}

for sig in HUP INT QUIT TERM; do
	# shellcheck disable=SC2064
	trap "abort 'Killed by SIG$sig.'" "$sig"
done

# Use the user's shell in the script we submit to Condor
shell=${SHELL:-/bin/sh}

# Get any requirements from the user's environment
requirements=
have_requirements=0
if [[ -n ${CONDOR_REQUIREMENTS+set} ]]; then
	requirements=$CONDOR_REQUIREMENTS
	have_requirements=1
fi
if [[ -n ${CONDOR_ARCH+set} ]]; then
	(( have_requirements )) && requirements+=" && "
	requirements+="Arch == \"$CONDOR_ARCH\""
	have_requirements=1
fi
if [[ -n ${CONDOR_OPSYS+set} ]]; then
	(( have_requirements )) && requirements+=" && "
	requirements+="OpSys == \"$CONDOR_OPSYS\""
	have_requirements=1
fi

# Refuse to overwrite a pre-existing temporary file
set -o noclobber

# Create a shell script containing the user's command
{
	printf '#!%s\n' "$shell"
	printf '%s ' "${command[@]}"
	printf '\n'
} > "$cmd_file" || abort "Can't create temporary (CMD) file in current directory."
chmod 0700 "$cmd_file"

# Create a job description file to submit the shell script to Condor
{
	echo "universe = $universe"
	echo "executable = $cmd_file"
	echo "initialdir = $PWD"
	echo "notification = NEVER"
	echo "log = $log_file"
	echo "output = $out_file"
	echo "error = $err_file"
	(( getenv_flag )) && echo "getenv = True"
	(( have_requirements )) && echo "requirements = $requirements"
	for append in "${appends[@]}"; do
		printf '%s\n' "$append"
	done
	echo "queue"
} > "$submit_file" || abort "Can't create temporary (JDF) file in current directory."

set +o noclobber

# Submit the job.  The job's stderr goes straight to the terminal so the
# user sees any submit warnings; stdout is parsed for the cluster id.
submit_output=$(condor_submit -terse "$submit_file")
submit_status=$?

submit_errors=
while IFS= read -r line; do
	if [[ $line =~ ^([0-9]+)\.[0-9]+\ - ]]; then
		cluster=${BASH_REMATCH[1]}
	elif [[ $line =~ WARNING.*Invalid\ log\ file || $line =~ WARNING.*is\ not\ writable\ by\ condor ]]; then
		printf '%s\n' "$line" >&2
		abort "Failed to submit Condor job."
	else
		submit_errors+="$line"$'\n'
	fi
done <<< "$submit_output"

if [[ $submit_status -ne 0 || -z $cluster ]]; then
	printf '%s' "$submit_errors" >&2
	abort "Failed to submit Condor job."
fi

# Watch the Condor log to see when the job completes
done=0
status=0
while (( ! done )); do
	# Sleep in the background so trapped signals are handled promptly
	sleep 5 &
	wait $!
	[[ -r $log_file ]] || abort "Failed to open Condor log file."
	while IFS= read -r line; do
		if [[ $line =~ termination\ \(return\ value\ ([0-9]+)\) ]]; then
			status=${BASH_REMATCH[1]}
			done=1
		elif [[ $line =~ termination\ \(signal\ ([0-9]+)\) ]]; then
			echo "Condor job killed by signal ${BASH_REMATCH[1]}." >&2
			done=1
		elif [[ $line == 009* && $line == *"Job was aborted"* ]]; then
			echo "The job was aborted" >&2
			done=1
		fi
	done < "$log_file"
done
cluster=	# the job is no longer in the queue

# Display the job's stdout and stderr on the terminal
cat "$out_file" || abort "Failed to open job output file."
cat "$err_file" >&2 || abort "Failed to open job error file."

cleanfiles

exit "$status"
