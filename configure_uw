#!/bin/sh

echo "-------------------------------------------------------------------"
echo "* NOTE: Attempting to configure a UW-esk build"
echo "*"
echo "* add -D_DEBUG:BOOL=FALSE to get non-optimized code for debugging"
echo "* Another option would be to run ccmake or cmake-gui"
echo "-------------------------------------------------------------------"

export CXXFLAGS
if type dpkg-buildflags > /dev/null 2>&1
then
	CXXFLAGS="$(dpkg-buildflags --get CXXFLAGS) ${CXXFLAGS}"
	echo "Using dpkg-buildflags to set CXXFLAGS to ${CXXFLAGS}"
else
	if type rpm > /dev/null 2>&1
	then
		CXXFLAGS="$(rpm --eval '%build_cxxflags') ${CXXFLAGS}"
		echo "Using rpm to set CXXFLAGS to ${CXXFLAGS}"
	else
		echo "No dpkg-buildflags or rpmbuild found, using default CXXFLAGS"
	fi
fi

cmake -DPROPER:BOOL=FALSE -D_VERBOSE:BOOL=TRUE -DBUILDID:STRING=UW_development "$@"
