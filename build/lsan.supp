# LSAN Suppressions file

# These are leak-on-exit
leak:SharedPortEndpoint::ReceiveSocket
leak:CollectorList::create
leak:SharedPortState::HandleUnbound
leak:SharedPortClient::PassSocket

# OpenSSL's internal global PRNG/DRBG state, seeded once via RAND_seed.
# Our own seed buffer is freed; the leak is inside OpenSSL and one-time.
leak:add_seed_prng

# The collector's self-signed CA, generated once at main_init and held for
# the life of the process (see collector_main.cpp).
leak:generate_x509_ca
leak:generate_key

# A test we don't care that leaks
leak:test_log_writer

# Can't fix perl
leak:/usr/bin/perl
leak:Perl_call_list

#  Or apptainer/mqsuashfs
leak:mksquashfs

leak:AllocNoTrack
leak:pymain_init

# Java
leak:os::malloc
leak:os::strdup
leak:JLI_

# Bash
leak:/usr/bin/bash

# There are surely bona-fide leaks here, but there are thousands of output files
leak:PyObject_

# Binaries that get libasan injected into them
leak:/usr/bin/cp
leak:/usr/bin/expr
leak:/usr/bin/mktemp
leak:/usr/bin/sort
leak:/usr/bin/tail
